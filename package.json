    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "i18n-js": "^4.5.4",
    "lottie-react-native": "~7.5.0",
    "lucide-react-native": "^1.72.0",
